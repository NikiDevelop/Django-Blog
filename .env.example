# Copia este fichero como .env junto a manage.py y rellénalo.
# El script deploy/instalar_vps.sh lo crea automáticamente en el servidor.

# False en producción
DJANGO_DEBUG=False

# Clave larga y aleatoria. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto

# Dominios desde los que se servirá la web, separados por comas
DJANGO_ALLOWED_HOSTS=midominio.com,www.midominio.com

# Orígenes HTTPS de confianza para formularios (el admin, por ejemplo)
DJANGO_CSRF_TRUSTED_ORIGINS=https://midominio.com,https://www.midominio.com

# True cuando el dominio ya tenga certificado HTTPS: activa la redirección y las cookies seguras
DJANGO_HTTPS=False

# HSTS en segundos. Déjalo en 0 hasta comprobar que HTTPS funciona; luego 3600 y, más adelante, 31536000
DJANGO_HSTS_SECONDS=0
